# Needed for the Live section. Copy this file to .env and fill them in.
IQAIR_API_KEY=
TOMTOM_API_KEY=

# Optional. Defaults are shown; the deployment guide in the README explains when to change them.
# HOST=127.0.0.1          # use 0.0.0.0 when deploying
# PORT=8000
# TRUST_PROXY=1           # only when a proxy (Render, Fly, nginx...) sits in front
# CACHE_SECONDS=600       # reuse a reading for this long
# RATE_LIMIT=30           # API requests per visitor per minute
# DAILY_UPSTREAM_CAP=400  # calls per provider per day (free plans are small)
# UPSTREAM_TIMEOUT_MS=8000 # how long to wait for IQAir or TomTom
